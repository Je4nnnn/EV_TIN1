# Copy this file to .env on the EC2 instance and replace the IP/host values.

DOCKERHUB_NAMESPACE=hotelrm-local
IMAGE_TAG=aws

# Public endpoints. Use http://<EC2_PUBLIC_IP> for an academic demo without domain/TLS.
PUBLIC_BASE_URL=http://<EC2_PUBLIC_IP>
VITE_KEYCLOAK_PUBLIC_URL=http://<EC2_PUBLIC_IP>:8080

# Host ports exposed by Docker Compose.
APP_PORT=80
BACKEND_PORT=8091
KEYCLOAK_PORT_DOCKER=8080

# Database.
DB_NAME=hotelrm
DB_USER=hotelrm_app
DB_PASSWORD=changeit

# Keycloak realm/client.
KEYCLOAK_REALM=hotelrm
KEYCLOAK_CLIENT_ID=hotelrm-frontend
KEYCLOAK_ADMIN_ROLE=hotelrm_admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Backend token validation must match the public issuer used by the browser.
KEYCLOAK_AUTH_SERVER_URL_DOCKER=http://keycloak:8080
KEYCLOAK_ISSUER_URI_DOCKER=http://<EC2_PUBLIC_IP>:8080/realms/hotelrm
KEYCLOAK_JWK_SET_URI_DOCKER=http://keycloak:8080/realms/hotelrm/protocol/openid-connect/certs

# The browser calls /api through the public Nginx container.
VITE_API_BASE_URL_DOCKER=/
VITE_PAYROLL_BACKEND_SERVER_DOCKER=/
VITE_KEYCLOAK_ENABLED_DOCKER=true

# CORS is still useful if you open backend endpoints directly during testing.
CORS_ALLOWED_ORIGINS_DOCKER=http://<EC2_PUBLIC_IP>,http://<EC2_PUBLIC_IP>:80

APP_SECURITY_ENABLED_DOCKER=true
APP_DEMO_SEED_ENABLED=true
