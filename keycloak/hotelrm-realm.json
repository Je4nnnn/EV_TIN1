{
  "realm": "hotelrm",
  "enabled": true,
  "sslRequired": "none",
  "displayName": "HotelRM",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      {
        "name": "hotelrm_admin",
        "description": "Administrative access for HotelRM"
      }
    ]
  },
  "users": [
    {
      "username": "hotelrm-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "HotelRM",
      "lastName": "Admin",
      "email": "admin@hotelrm.local",
      "credentials": [
        {
          "type": "password",
          "value": "changeit",
          "temporary": false
        }
      ],
      "realmRoles": [
        "hotelrm_admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "hotelrm-frontend",
      "name": "HotelRM Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://127.0.0.1",
        "http://localhost",
        "http://localhost:3000",
        "http://localhost:3001",
        "http://localhost:5173",
        "+"
      ],
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email",
        "roles"
      ]
    }
  ]
}
